#!/usr/bin/env bash
# Set (or change) the portal password. Changing it logs out every device.
set -euo pipefail
DIR="$(cd "$(dirname "$0")/.." && pwd)"
NODE="${NODE:-$HOME/.local/node/bin/node}"

if [ -t 0 ]; then
  read -rsp "New portal password: " pw1; echo
  read -rsp "Again: " pw2; echo
  [ "$pw1" = "$pw2" ] || { echo "Passwords don't match." >&2; exit 1; }
else
  read -r pw1  # piped on stdin, e.g. for scripted setup
fi
[ "${#pw1}" -ge 8 ] || { echo "Use at least 8 characters." >&2; exit 1; }

printf '%s' "$pw1" | "$NODE" -e '
const crypto = require("crypto"), fs = require("fs");
let pw = ""; process.stdin.on("data", (c) => pw += c).on("end", () => {
  const salt = crypto.randomBytes(16);
  const hash = crypto.scryptSync(pw, salt, 32, { N: 1 << 15, r: 8, p: 1, maxmem: 64 * 1024 * 1024 });
  const out = process.argv[1] + "/data/auth.json";
  fs.writeFileSync(out, JSON.stringify({ salt: salt.toString("hex"), hash: hash.toString("hex") }), { mode: 0o600 });
  console.log("Password saved. Log in again on each device.");
});' "$DIR"
